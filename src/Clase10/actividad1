public class actividad1 {
    static int N = 4;

    public static void main(String[] args) {
            resolverDosReinas();
        }

        public static void resolverDosReinas() {
            int tablero[][] = new int[N][N]; // Crear un tablero vacío
            colocarReina(tablero, 0, 0, 0); 
        }

        // Función recursiva
        public static boolean colocarReina(int tablero[][], int fila, int col, int reinasColocadas) {
            if (reinasColocadas == 2) { // Si se han colocado dos reinas
                imprimirTablero(tablero);
                return true;
            }

            // Recorrer todas las filas y columnas 
            for (int i = fila; i < N; i++) {
                for (int j = col; j < N; j++) {
                    if (esSeguro(tablero, i, j)) {
                        tablero[i][j] = 1; // Colocar reina

                        // Intentar colocar la siguiente reina
                        colocarReina(tablero, i, j + 1, reinasColocadas + 1);

                        //eliminar reina si no es solución
                        tablero[i][j] = 0;
                    }
                }
                col = 0; // Reinicia columna cuando pasamos a la siguiente fila
            }

            return false; // borra la rama
        }

    public static boolean esSeguro(int tablero[][], int fila, int col) {
        // Verifica fila actual
        for (int i = 0; i < N; i++) {
            if (tablero[fila][i] == 1 || tablero[i][col] == 1) {
                return false;
            }
        }

        // Verifica diagonal sup izquierda e inf derecha
        for (int i = fila, j = col; i >= 0 && j >= 0; i--, j--) {
            if (tablero[i][j] == 1) {
                return false;
            }
        }
        for (int i = fila, j = col; i < N && j < N; i++, j++) {
            if (tablero[i][j] == 1) {
                return false;
            }
        }

        // Verificar diagonal sup derecha e inf izquierda
        for (int i = fila, j = col; i >= 0 && j < N; i--, j++) {
            if (tablero[i][j] == 1) {
                return false;
            }
        }
        for (int i = fila, j = col; i < N && j >= 0; i++, j--) {
            if (tablero[i][j] == 1) {
                return false;
            }
        }

        return true;
    }
        public static void imprimirTablero(int tablero[][]) {
            for (int i = 0; i < N; i++) {
                for (int j = 0; j < N; j++) {
                    if (tablero[i][j] == 1) {
                        System.out.print("R ");
                    } else {
                        System.out.print(". ");
                    }
                }
                System.out.println();
            }
            System.out.println();
        }
    }
